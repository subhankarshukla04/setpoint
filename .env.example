# CutTrack — local environment template. Copy to .env and fill in.
# Never commit .env.

# ─── OpenRouter (coach LLM via Gemini) ────────────────────────────────
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_COACH_MODEL=google/gemini-2.0-flash-exp:free

# ─── Service ports (local dev) ────────────────────────────────────────
KNOWLEDGE_SERVICE_PORT=8003
WEB_PORT=3001

# ─── KB paths ─────────────────────────────────────────────────────────
KB_WIKI_DIR=./research/wiki
KB_CITATIONS=./research/citations.json
KB_DB_PATH=./services/knowledge-service/data/kb.sqlite

# ─── App data (single-user SQLite) ────────────────────────────────────
APP_DB_PATH=./data/cutrack.db
